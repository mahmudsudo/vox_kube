# BasicPersistentVolumeFlow

main: kit: flow: BasicPersistentVolumeFlow:
{
  entity: "persistent_volume",
  kind: "basic",
  name: "BasicPersistentVolumeFlow",
  step: [
    {
      i: {
        ref: "persistent_volume_ref01",
        srcdatavar: "persistent_volume_ref01_data",
        suffix: "_up0",
        textfield: "apiVersion"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-persistent_volume_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "persistent_volume_ref01",
        srcdatavar: "persistent_volume_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "persistent_volume01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-persistent_volume_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPersistentVolumeFlow"
}