# BasicServiceaccountFlow

main: kit: flow: BasicServiceaccountFlow:
{
  entity: "serviceaccount",
  kind: "basic",
  name: "BasicServiceaccountFlow",
  step: [
    {
      i: {
        ref: "serviceaccount_ref01",
        srcdatavar: "serviceaccount_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-serviceaccount_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicServiceaccountFlow"
}