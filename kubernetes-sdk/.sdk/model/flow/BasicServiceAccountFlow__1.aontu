# BasicServiceAccountFlow

main: kit: flow: BasicServiceAccountFlow:
{
  entity: "service_account",
  kind: "basic",
  name: "BasicServiceAccountFlow",
  step: [
    {
      i: {
        ref: "service_account_ref01",
        srcdatavar: "service_account_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "service_account01",
        namespace_id: "namespace01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-service_account_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicServiceAccountFlow"
}