      r: false
      t: "`$STRING`"
    }
    involvedObject: {
      h: "Involved Object"
      n: "involvedObject"
      r: true
      sh: "involvedObject is the object that this event is about."
      t: "`$ANY`"
    }
    kind: {
      h: "Kind"
      n: "kind"
      r: false
      sh: "Kind is a string value representing the REST resource this object represents."
      t: "`$STRING`"
    }
    lastTimestamp: {
      h: "Last Timestamp"
      n: "lastTimestamp"
      r: false
      sh: "lastTimestamp is the time at which the most recent occurrence of this event was recorded."
      t: "`$ANY`"
    }
    message: {
      h: "Message"
      n: "message"
      r: false
      sh: "message is a human-readable description of the status of this operation."
      t: "`$STRING`"
    }
    metadata: {
      h: "Metadata"
      n: "metadata"
      r: true
      sh: "metadata is the standard object's metadata."
      t: "`$ANY`"
    }
    object: {
      h: "Object"
      n: "object"
      r: true
      sh: "Object is: * If Type is Added or Modified: the new state of the object."
      t: "`$ANY`"
    }
    reason: {
      h: "Reason"
      n: "reason"
      r: false
      sh: "reason is a short, machine understandable string that gives the reason for the transition into the object's current status."
      t: "`$STRING`"
    }
    related: {
      h: "Related"
      n: "related"
      r: false
      sh: "related is an optional secondary object for more complex actions."
      t: "`$ANY`"
    }
    reportingComponent: {
      h: "Reporting Component"
      n: "reportingComponent"
      r: false
      sh: "reportingComponent is the name of the controller that emitted this Event, e.g."
