    }
    count: {
      fo: "int32"
      h: "Count"
      n: "count"
      r: false
      sh: "count is the number of times this event has occurred."
      t: "`$INTEGER`"
    }
    eventTime: {
      h: "Event Time"
      n: "eventTime"
      r: false
      sh: "eventTime is the time when this Event was first observed."
      t: "`$ANY`"
    }
    firstTimestamp: {
      h: "First Timestamp"
      n: "firstTimestamp"
      r: false
      sh: "firstTimestamp is the time at which the event was first recorded."
