# BasicCredentialPublicKeyFlow

main: kit: flow: BasicCredentialPublicKeyFlow:
{
  entity: "credential_public_key",
  kind: "basic",
  name: "BasicCredentialPublicKeyFlow",
  step: [
    {
      i: {
        ref: "credential_public_key_ref01"
      }

      m: {
        sid: "sid01"
      }

      o: "create"
    }

    {
      i: {
        ref: "credential_public_key_ref01",
        srcdatavar: "credential_public_key_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "credential_public_key01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-credential_public_key_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCredentialPublicKeyFlow"
}